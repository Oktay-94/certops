# Local development — SQLite file. Copy to .env.local.
DATABASE_URL=file:./data/certops.db

# DATABASE_AUTH_TOKEN intentionally unset for local file: URLs.
# For live (Turso) credentials, use a separate .env.turso file consumed
# only by db:migrate:remote / db:seed:remote scripts.

# TTS (ElevenLabs + Vercel Blob) — see PR #22
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# optional, default: eleven_flash_v2_5
ELEVENLABS_MODEL_ID=
BLOB_READ_WRITE_TOKEN=
